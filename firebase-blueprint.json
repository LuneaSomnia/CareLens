{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "User ID" },
        "name": { "type": "string" },
        "age": { "type": "string" },
        "gender": { "type": "string" },
        "email": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "nationalId": { "type": "string" },
        "location": { "type": "string" },
        "conditions": { "type": "string" },
        "allergies": { "type": "string" },
        "medications": { "type": "string" },
        "familyHistory": { "type": "string" },
        "organDonor": { "type": "boolean" },
        "donatedOrgans": { "type": "string" },
        "diet": { "type": "string" },
        "activity": { "type": "string" },
        "sleep": { "type": "string" },
        "substanceUse": { "type": "string" },
        "pushNotificationsEnabled": { "type": "boolean" }
      },
      "required": ["uid", "name", "email"]
    },
    "Recommendation": {
      "title": "Recommendation",
      "description": "A recommendation generated by CareLens",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "category": { "type": "string", "enum": ["PREVENTION", "MANAGEMENT", "ANALYSIS"] },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "category", "text", "createdAt", "expiresAt"]
    },
    "ProcedureRecord": {
      "title": "ProcedureRecord",
      "description": "A recommended procedure (vaccine, test, screening)",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhone": { "type": "string" },
        "userNationalId": { "type": "string" },
        "type": { "type": "string", "enum": ["VACCINE", "TEST", "SCREENING"] },
        "name": { "type": "string" },
        "facility": { "type": "string" },
        "doctorName": { "type": "string" },
        "doctorId": { "type": "string" },
        "results": { "type": "string" },
        "procedureDate": { "type": "string" },
        "procedureTime": { "type": "string" },
        "completed": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "userPhone", "userNationalId", "type", "name", "facility", "completed", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles"
    },
    "/recommendations/{recommendationId}": {
      "schema": { "$ref": "#/entities/Recommendation" },
      "description": "Recommendations generated for users"
    },
    "/procedures/{procedureId}": {
      "schema": { "$ref": "#/entities/ProcedureRecord" },
      "description": "Procedures recommended for users"
    }
  }
}
